<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Accounts">
            <directory>Modules/Accounts/Tests</directory>
        </testsuite>
        <testsuite name="ActivityLog">
            <directory>Modules/ActivityLog/Tests</directory>
        </testsuite>
        <testsuite name="Category">
            <directory>Modules/Category/Tests</directory>
        </testsuite>
        <testsuite name="Currency">
            <directory>Modules/Currency/Tests</directory>
        </testsuite>
        <testsuite name="Debts">
            <directory>Modules/Debts/Tests</directory>
        </testsuite>
        <testsuite name="FinancialGoal">
            <directory>Modules/FinancialGoal/Tests</directory>
        </testsuite>
        <testsuite name="Friends">
            <directory>Modules/Friends/Tests</directory>
        </testsuite>
        <testsuite name="Language">
            <directory>Modules/Language/Tests</directory>
        </testsuite>
        <testsuite name="Notification">
            <directory>Modules/Notification/Tests</directory>
        </testsuite>
        <testsuite name="RecurringTransaction">
            <directory>Modules/RecurringTransaction/Tests</directory>
        </testsuite>
        <testsuite name="SharedRoles">
            <directory>Modules/SharedRoles/Tests</directory>
        </testsuite>
        <testsuite name="User">
            <directory>Modules/User/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
